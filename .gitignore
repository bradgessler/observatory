# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

_site/

# the custom Nerves system: its build log and local artifact pointers stay local
systems/*/build.log
systems/*/.nerves/

# compiled by each app's Makefile (elixir_make) for the machine it builds on: never committed
/apps/camera/priv/usbport
/apps/camera/priv/.usbport-cc
/apps/input/priv/hidport

# where the scope is: never in this public repository (config/config.exs says how it is found)
/config/site.secret.exs

# formats that carry metadata by design (and are big): they live with the night under ~/.observatory, never here
*.fits
*.fit
*.fts
*.tif
*.tiff
*.xisf
*.ARW
*.arw
*.CR2
*.cr3
*.nef
*.dng
*.npz
*.npy
