# ---- Bluetooth (Observatory) -------------------------------------------------------
# BlueZ over D-Bus, driven from Elixir by the `bluez` package, which starts
# and supervises dbus-daemon and bluetoothd itself (no init scripts). The
# HID plugin is the input profile: Classic HID and HID over GATT, so a
# paired game pad appears as /dev/hidraw* like a wired one. The distro
# firmware package carries each Pi radio's patchram (.hcd) file.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_RPI_DISTRO_BLUEZ_FIRMWARE=y
# Plate solving (Align by Photo): astrometry.net's C programs, and djpeg to
# turn a phone's JPEG into something they read
BR2_PACKAGE_ASTROMETRY_NET=y
BR2_PACKAGE_CFITSIO=y
BR2_PACKAGE_JPEG_TURBO_TOOLS=y
BR2_PACKAGE_GSL=y
BR2_PACKAGE_BZIP2=y
# The telescope camera: a USB "UVC" camera (the SVBONY SV105 and most
# planetary cameras). v4l2-ctl sets its exposure and gain and grabs frames;
# ffmpeg streams it to a phone for focusing (Video's v4l2 input, encoded on
# the Pi's own H.264 block).
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
BR2_PACKAGE_FFMPEG=y
# scaling and pixel-format conversion (the camera's YUYV or MJPEG to gray,
# halved): off by default in Buildroot, and every frame needs it. Buildroot
# doesn't rebuild a package when only its options change: after changing an
# ffmpeg option, clear build/ffmpeg-* in the build volume.
BR2_PACKAGE_FFMPEG_SWSCALE=y
